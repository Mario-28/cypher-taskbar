{
  "id": "cypher-taskbar",
  "title": "Cypher Taskbar",
  "description": "Adds a sleek, automated, and highly customizable bar to the Foundry VTT HUD for tracking Character Pools, Experience, and more in the Cypher System. Supports automated character sheet integration, pop-out widgets, and GM tools for approval workflows.",
  "version": "4.0.46",
  "type": "module",
  "compatibility": {
    "minimum": "14",
    "verified": "14",
    "maximum": "15"
  },
  "authors": [
    {
      "name": "Cypher Taskbar Team"
    }
  ],
  "esmodules": [
    "scripts/cypher-taskbar.js"
  ],
  "styles": [
    "styles/cypher-taskbar.css"
  ],
  "languages": [
    {
      "lang": "en",
      "name": "English",
      "path": "languages/en.json"
    }
  ],
  "socket": true,
  "relationships": {
    "systems": [
      {
        "id": "cyphersystem",
        "type": "system",
        "compatibility": {
          "minimum": "3.0.0"
        }
      }
    ]
  },
  "manifest": "https://github.com/foundryvtt/cypher-taskbar/releases/latest/download/module.json",
  "download": "https://github.com/foundryvtt/cypher-taskbar/releases/download/v2.5.30/cypher-taskbar-v2.5.30.zip",
  "readme": "https://github.com/foundryvtt/cypher-taskbar/blob/main/README.md",
  "changelog": "https://github.com/foundryvtt/cypher-taskbar/blob/main/CHANGELOG.md",
  "bugs": "https://github.com/foundryvtt/cypher-taskbar/issues",
  "flags": {
    "hotReload": {
      "extensions": [
        "css",
        "html",
        "hbs",
        "json"
      ],
      "paths": [
        "styles/cypher-taskbar.css",
        "languages/en.json"
      ]
    }
  }
}